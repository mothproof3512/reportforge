{
  "name": "reportforge",
  "version": "0.1.0",
  "private": true,
  "description": "Modular, whitelabel pentest reporting framework. Markdown in, world-class PDF and DOCX out.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "rf": "tsx packages/cli/src/index.ts",
    "render": "tsx packages/cli/src/index.ts render",
    "check": "tsx packages/cli/src/index.ts check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:render": "tsx tests/render/run.ts",
    "test:all": "npm test && npm run test:render",
    "blocks:check": "tsx packages/cli/src/index.ts blocks check",
    "fixtures:stress": "node tests/fixtures/stress/generate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "docx": "^9.7.1",
    "mdast-util-from-markdown": "^2.0.3",
    "sharp": "^0.35.4",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
