{
  "name": "reportforge",
  "version": "0.7.0",
  "private": true,
  "description": "Modular, whitelabel pentest reporting framework. Markdown in, world-class PDF and DOCX out.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "rf": "tsx packages/cli/src/index.ts",
    "render": "tsx packages/cli/src/index.ts render",
    "check": "tsx packages/cli/src/index.ts check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:render": "tsx tests/render/run.ts",
    "test:all": "npm test && npm run test:render && npm run test:e2e",
    "blocks:check": "tsx packages/cli/src/index.ts blocks check",
    "fixtures:stress": "node tests/fixtures/stress/generate.mjs",
    "web:build": "node apps/web/build.mjs",
    "web:dev": "node apps/web/build.mjs --watch",
    "start": "node --import tsx apps/web/server/index.ts",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "release": "node scripts/release.mjs",
    "version:check": "node scripts/release.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "docx": "^9.7.1",
    "mdast-util-from-markdown": "^2.0.3",
    "sharp": "^0.35.4",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "marked": "^18.0.10",
    "dompurify": "^3.4.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.28.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/dompurify": "^3.0.5",
    "playwright": "^1.58.0"
  }
}
