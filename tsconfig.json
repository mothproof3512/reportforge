{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@reportforge/core": [
        "./packages/core/src/index.ts"
      ],
      "@reportforge/markdown": [
        "./packages/markdown/src/index.ts"
      ],
      "@reportforge/risk": [
        "./packages/risk/src/index.ts"
      ],
      "@reportforge/render-typst": [
        "./packages/render-typst/src/index.ts"
      ],
      "@reportforge/render-docx": [
        "./packages/render-docx/src/index.ts"
      ],
      "@reportforge/preflight": [
        "./packages/preflight/src/index.ts"
      ],
      "@reportforge/importers": [
        "./packages/importers/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "modules/**/*.ts",
    "tests/**/*.ts",
    "apps/web/server/**/*.ts"
  ]
}